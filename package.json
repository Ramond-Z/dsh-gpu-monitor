{
  "name": "dsh-gpu-monitor",
  "version": "0.1.0",
  "description": "GPU 用量实时监控（多机/SSH）：DeepSeek Harness 侧边栏插件 + 独立程序。npm run macbook 网页模式或 npm run app 原生应用（Electron，MacBook 自包含，无需浏览器）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./sidecar": "./lib/sidecar.mjs",
    "./server": "./lib/server.mjs",
    "./engine": "./lib/engine.mjs",
    "./orderstore": "./lib/orderstore.mjs",
    "./sshconfig": "./lib/sshconfig.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "electron",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "sidecar": "node lib/sidecar.mjs",
    "macbook": "bash scripts/macbook.sh",
    "start": "node lib/sidecar.mjs",
    "app": "electron electron/main.mjs",
    "app:window": "GPU_MONITOR_UI_MODE=window electron electron/main.mjs",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "com.ramondz.gpu-monitor",
    "productName": "GPU Monitor",
    "files": [
      "lib/**",
      "electron/**",
      "cordis.patch.yml",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "gpu",
    "nvidia-smi",
    "monitor",
    "macbook",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ramond-Z/dsh-gpu-monitor.git"
  }
}
